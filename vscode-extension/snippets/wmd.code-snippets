{
  "New Tab": {
    "prefix": "@tab",
    "body": [
      "@tab ${1:Tab Name}",
      "@title ${2:Title}",
      "",
      "# ${3:Heading}",
      "",
      "$0"
    ],
    "description": "Create a new WMD tab with a title and first heading"
  },
  "Config Block": {
    "prefix": "@config",
    "body": [
      "@config",
      "font: ${1:Arial, sans-serif}",
      "monoFont: ${2:Consolas, monospace}",
      "baseSize: ${3:16px}",
      "lineHeight: ${4:1.6}",
      "contentWidth: ${5:900px}",
      "Title: {keybind: Ctrl+Shift+`; size: ${6:3rem}; font: ${7:Arial, sans-serif}; bold: true; heading: 1};",
      "Heading 1: {keybind: Ctrl+Shift+1; size: ${8:2rem}; font: ${9:Arial, sans-serif}; bold: true; heading: 1};",
      "Normal Text: {keybind: Ctrl+Shift+0; size: ${10:16px}; font: ${11:Arial, sans-serif}; paragraph: true};",
      "Italic List: {keybind: Ctrl+Alt+L; italic: true; unordered-list: true};",
      "Warning Box: {keybind: Ctrl+Alt+W; callout: warning; bold: true};",
      "@endconfig",
      "",
      "$0"
    ],
    "description": "Insert a WMD config block with document settings and style presets"
  },
  "Title": {
    "prefix": "@title",
    "body": "@title ${1:Title}",
    "description": "Insert a tab title"
  },
  "Wiki Link": {
    "prefix": "link",
    "body": "[[${1:Tab Name}${2:#Heading}|${3:Label}]]",
    "description": "Insert a WMD wiki link"
  },
  "Wiki Link Without Label": {
    "prefix": "[[",
    "body": "[[${1:Tab Name}${2:#Heading}]]",
    "description": "Insert a WMD wiki link without a label"
  },
  "Yellow Highlight": {
    "prefix": "=",
    "body": "=${1:yellow note}=",
    "description": "Yellow highlight"
  },
  "Orange Highlight": {
    "prefix": "==",
    "body": "==${1:important note}==",
    "description": "Light orange highlight"
  },
  "Red Highlight": {
    "prefix": "===",
    "body": "===${1:warning note}===",
    "description": "Light red highlight"
  },
  "Bold": {
    "prefix": "bold",
    "body": "*${1:bold text}*",
    "description": "Bold text"
  },
  "Italic": {
    "prefix": "italic",
    "body": "_${1:italic text}_",
    "description": "Italic text"
  },
  "Code Fence": {
    "prefix": "code",
    "body": [
      "```${1:js}",
      "$0",
      "```"
    ],
    "description": "Insert a fenced code block"
  },
  "Hidden Tab": {
    "prefix": "@hidden",
    "body": "@hidden",
    "description": "Mark the current WMD tab as hidden"
  },
  "Table of Contents": {
    "prefix": "@toc",
    "body": "@toc depth: ${1:3}",
    "description": "Insert a per-tab table of contents"
  },
  "Include": {
    "prefix": "@include",
    "body": "@include ${1:Tab Name}${2:#Heading}",
    "description": "Include another tab or heading section"
  },
  "Embed": {
    "prefix": "@embed",
    "body": "@embed ${1:Tab Name}${2:#Heading}",
    "description": "Embed another tab or heading section"
  },
  "Variable": {
    "prefix": "@var",
    "body": "@var ${1:name} = ${2:value}",
    "description": "Define a WMD variable"
  },
  "Variable Reference": {
    "prefix": "{{",
    "body": "{{${1:name}}}",
    "description": "Insert a WMD variable reference"
  },
  "Note Callout": {
    "prefix": "!note",
    "body": [
      "!note ${1:Title}",
      "${2:Content}",
      "!end"
    ],
    "description": "Insert a note callout"
  },
  "Warning Callout": {
    "prefix": "!warning",
    "body": [
      "!warning ${1:Title}",
      "${2:Content}",
      "!end"
    ],
    "description": "Insert a warning callout"
  },
  "Rule Callout": {
    "prefix": "!rule",
    "body": [
      "!rule ${1:Title}",
      "${2:Content}",
      "!end"
    ],
    "description": "Insert a rule callout"
  },
  "Example Callout": {
    "prefix": "!example",
    "body": [
      "!example ${1:Title}",
      "${2:Content}",
      "!end"
    ],
    "description": "Insert an example callout"
  },
  "Collapse": {
    "prefix": "@collapse",
    "body": [
      "@collapse ${1:Title}",
      "${2:Hidden content}",
      "@endcollapse"
    ],
    "description": "Insert a collapsible section"
  },
  "Styled Block": {
    "prefix": "@style",
    "body": [
      "@style ${1:Style Name}",
      "${2:Styled content}",
      "@end"
    ],
    "description": "Apply a configured style to a block"
  },
  "Inline prose": {
    "prefix": "wmd-prose-inline",
    "body": [
      "<<<${1:term or phrase}>>>"
    ],
    "description": "Insert unboxed WMD inline prose"
  },
  "Tab Stops": {
    "prefix": "@tabstops",
    "body": [
      "@tabstops ${1:12em}, ${2:24em}",
      "${3:Label} \\tab ${4:Aligned text}",
      "$0",
      "@endtabstops"
    ],
    "description": "Create independently positioned ruler tab stops for aligned WMD content"
  },
  "Footnote reference": {
    "prefix": "footnote",
    "body": [
      "[^${1:key}]"
    ],
    "description": "Insert a footnote reference"
  },
  "Footnote definition": {
    "prefix": "footnote-def",
    "body": [
      "[^${1:key}]: ${2:Footnote text}"
    ],
    "description": "Define a footnote"
  },
  "Endnote reference": {
    "prefix": "endnote",
    "body": [
      "[^end:${1:key}]"
    ],
    "description": "Insert an endnote reference"
  },
  "Endnote definition": {
    "prefix": "endnote-def",
    "body": [
      "[^end:${1:key}]: ${2:Endnote text}"
    ],
    "description": "Define an endnote"
  },
  "Numbered figure": {
    "prefix": "@figure",
    "body": [
      "@figure ${1:label} | ${2:Caption}",
      "${3:Figure content}",
      "@endfigure"
    ],
    "description": "Insert a numbered, referenceable figure"
  },
  "Numbered table": {
    "prefix": "@table",
    "body": [
      "@table ${1:label} | ${2:Caption}",
      "| Column | Value |",
      "| ------ | ----- |",
      "| ${3:Row} | ${4:Cell} |",
      "@endtable"
    ],
    "description": "Insert a numbered, referenceable table"
  },
  "Numbered equation": {
    "prefix": "@equation",
    "body": [
      "@equation ${1:label} | ${2:Caption}",
      "$$${3:x = y}$$",
      "@endequation"
    ],
    "description": "Insert a numbered equation"
  },
  "Figure cross-reference": {
    "prefix": "figref",
    "body": [
      "[[fig:${1:label}]]"
    ],
    "description": "Refer to a numbered figure"
  },
  "Table cross-reference": {
    "prefix": "tblref",
    "body": [
      "[[tbl:${1:label}]]"
    ],
    "description": "Refer to a numbered table"
  },
  "Equation cross-reference": {
    "prefix": "eqref",
    "body": [
      "[[eq:${1:label}]]"
    ],
    "description": "Refer to a numbered equation"
  },
  "Nested callout": {
    "prefix": "nested-callout",
    "body": [
      "!note ${1:Outer}",
      "!warning ${2:Inner}",
      "${3:Content}",
      "!end",
      "!end"
    ],
    "description": "Insert nested callouts"
  }
}
